<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <LoaderDll>$(MSBuildThisFileDirectory)..\..\loader\bin\dinput8.dll</LoaderDll>
  </PropertyGroup>

  <!-- The loader DLL ships inside the app; build it with the MSVC Build Tools if it isn't there yet. -->
  <Target Name="BuildLoader" BeforeTargets="BeforeBuild" Condition="!Exists('$(LoaderDll)')">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)..\..\loader\build.cmd&quot;" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(LoaderDll)" LogicalName="dinput8.dll" />
    <!-- Data tables from Bartz24/FFModdingWPF (MIT, see third_party/FFModdingWPF). -->
    <EmbeddedResource Include="Data\*.csv" LogicalName="data/%(Filename)%(Extension)" />
    <!-- Open world base files from Bartz24/FFModdingWPF (MIT, see third_party/FFModdingWPF/openworld). -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\third_party\FFModdingWPF\openworld\openworld.zip" LogicalName="openworld.zip" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ff12Randomizer.Tests" />
  </ItemGroup>

</Project>
